<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.9.0</Version>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TermLume.Shared/TermLume.Shared.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.7.1" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.7.1" />
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
</Project>
