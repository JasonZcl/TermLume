<Window x:Class="TermLume.Views.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TermLume.Views"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#252537" Foreground="#ECECF5" FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="12" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E9E7F5" />
            <Setter Property="Background" Value="#35354A" />
            <Setter Property="BorderBrush" Value="#49495F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#DDD3FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#252537" BorderBrush="#49465E" BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="28,20,28,26">
            <Grid Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="#22A99BFF" Margin="0,0,10,0">
                        <Path Width="14" Height="16" Stretch="Uniform" Stroke="#C0B4FF" StrokeThickness="1.7"
                              Data="M4,7 L4,4 A4,4 0 0 1 12,4 L12,7 M2,7 L14,7 14,17 2,17 Z M8,11 L8,14" />
                    </Border>
                    <TextBlock Text="{local:Translate '安全连接'}" Foreground="#C0B4FF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" IsCancel="True" ToolTip="{local:Translate '取消连接 (Esc)'}" HorizontalAlignment="Right"
                        Padding="9,5" Background="Transparent" BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{local:Translate '取消连接'}" />
            </Grid>
            <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Border Margin="0,16,0,24" Background="#05FFFFFF" BorderBrush="#0CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="13,11">
                <StackPanel>
                    <TextBlock Text="{local:Translate '连接目标'}" Foreground="#8D8CA7" FontSize="10" Margin="0,0,0,5" />
                    <TextBlock x:Name="Endpoint" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="#D1CFE6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="SecretLabel" Text="{local:Translate 'SSH 登录密码'}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9" />
            <Border CornerRadius="9" BorderThickness="1" Padding="6,3" Background="#1C1C2B">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#4B485F" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#B1A1FF" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <PasswordBox x:Name="SecretInput" FontSize="18" Padding="9,10" Background="Transparent" Foreground="#F2EDFF"
                             CaretBrush="#C0B4FF" SelectionBrush="#7766AD" BorderThickness="0" MaxLength="4096"
                             AutomationProperties.LabeledBy="{Binding ElementName=SecretLabel}">
                    <PasswordBox.Template>
                        <ControlTemplate TargetType="PasswordBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></ControlTemplate>
                    </PasswordBox.Template>
                </PasswordBox>
            </Border>
            <TextBlock x:Name="InputHint" Foreground="#8D8CA7" FontSize="11" Margin="1,9,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="CapsLockHint" Text="{local:Translate 'Caps Lock 已开启，请注意密码大小写。'}" Foreground="#E6BD81" FontSize="11" Margin="1,7,0,0" Visibility="Collapsed" />
            <Border Background="#04FFFFFF" CornerRadius="8" Padding="12" Margin="0,22,0,24">
                <TextBlock Text="{local:Translate '仅用于本次连接，不保存密码或私钥口令。&#x0a;连接前仍会校验服务器指纹，保护远端身份。'}"
                           FontSize="11" LineHeight="19" Foreground="#A2A0BA" TextWrapping="Wrap" />
            </Border>
            <Grid>
                <TextBlock Text="{local:Translate 'Enter 连接  ·  Esc 取消'}" FontSize="10" Foreground="#85839D" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{local:Translate '取消'}" IsCancel="True" Margin="0,0,9,0" />
                    <Button x:Name="ConnectButton" Content="{local:Translate '连接 →'}" IsDefault="True" Background="#AB9AF5" Foreground="#211C36" BorderBrush="#BEAEFF" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
