<Window x:Class="TermLume.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TermLume.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TermLume · SSH 工作空间" Height="900" Width="1440"
        MinHeight="680" MinWidth="1060" WindowStartupLocation="CenterScreen"
        Background="#1E1E2F" Foreground="#ECEEF2"
        Icon="Assets/TermLume.ico" WindowStyle="None" ResizeMode="CanResize">
    <!-- 原生窗口负责边框缩放，标题栏按钮和拖动区域由网页界面处理。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <!-- 为原生缩放命中区留出空间，防止 WebView2 吞掉窗口边缘的鼠标事件。 -->
                <Setter Property="Margin" Value="6" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#1E1E2F" AllowExternalDrop="True" />
        <TextBlock x:Name="StartupMessage" Text="正在准备你的工作空间…" HorizontalAlignment="Center"
                   VerticalAlignment="Center" FontSize="16" Foreground="#A6ADB8" IsHitTestVisible="False" />
        <Button x:Name="StartupClose" Content="关闭" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="20" Padding="18,7" Background="#414157" Foreground="#ECEEF2" BorderBrush="#575771" />
    </Grid>
</Window>
